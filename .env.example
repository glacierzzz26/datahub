# datahub Phase 1 —— 环境变量样例（照抄为 .env 并填入真实值；.env chmod 600）

# ---------- 服务 ----------
DATAHUB_PORT=8100
# Bearer token（密钥）：openssl rand -hex 32。空 = 鉴权一律拒绝（fail-closed）
DATAHUB_TOKEN=change_me_strong_token
DATAHUB_LOG_LEVEL=info
# MCP Streamable HTTP 的 DNS-rebinding 允许 Host（默认本机）。
# 必须带 ':*' —— 真实客户端 Host 头含端口（http://127.0.0.1:8100），
# SDK 仅精确匹配或 'host:*' 通配，漏了 ':*' 会一律 421。跨机暴露时按拓扑加。
DATAHUB_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# ---------- 请求层超时（沿用 collector 口径）----------
DATAHUB_HTTP_CONNECT_TIMEOUT=5
DATAHUB_HTTP_READ_TIMEOUT=15
DATAHUB_REQUEST_TIMEOUT=15
# 杀开关：置 0 硬旁路请求层超时补丁（当日回滚，无需重建）
DATAHUB_HTTP_TIMEOUT_PATCH=1

# ---------- 缓存 / 限流 ----------
DATAHUB_CACHE_TTL_DEFAULT=300
DATAHUB_RATE_LIMIT=0.2
DATAHUB_RATE_CONCURRENCY=4
DATAHUB_BLOCK_COOLDOWN=1800

# ---------- 外部源采集闸门（默认全关 → 部署零外部请求）----------
# 双闸门：总开关 × 数据集白名单，两者都不点名 → 一条外部请求都不发
DATAHUB_EXT_ENABLED=
# 逗号白名单，如 hotspot.indices,hotspot.sectors_gain,industry.catalog
DATAHUB_EXT_DATASETS=

# ---------- 热点数据集 ----------
DATAHUB_HOTSPOT_INDICES=.DJI,.IXIC,.INX
DATAHUB_HOTSPOT_TOP_N=10

# ---------- 数据库（Phase 2：复用生产 PG 实例另建库 datahub）----------
# 本地开发连 127.0.0.1；compose 内由 docker-compose.yml 覆盖为 host.docker.internal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=quant
DB_PASSWORD=change_me
DB_NAME=datahub
# 连接池调小（默认 2+3）：与 steady 共享生产 PG max_connections
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# ---------- 采集闸门（Phase 2：接管核心采集，默认全关 → 部署零采集）----------
# 双闸门：总开关 × 数据集白名单，两者都不点名 → 不注册任务、不发采集请求、不写库。
# 数据集名：stock_basic / calendar / index / daily / valuation / finance
DATAHUB_COLLECT_ENABLED=
DATAHUB_COLLECT_DATASETS=

# ---------- 采集子系统（搬自 steady collector，env 名逐字保留）----------
# 采集器/源链旋钮沿用 steady 的 env 名（COLLECTOR_* / BAOSTOCK_* / TENCENT_* /
# COLLECT_SCOPE / DAILY_SOURCE_CHAIN），可直接从 steady .env 平移。关键项：
# BAOSTOCK_ENABLED=
# BAOSTOCK_SOURCES=daily,calendar
# TENCENT_ENABLED=
# TENCENT_SOURCES=
# COLLECT_SCOPE=pool
# healthz 端口（compose 对 datahub-collector 设 9200）
# HEALTH_PORT=9200
# 看门狗退出计数文件（compose 挂 ./logs）
# COLLECTOR_WATCHDOG_EXIT_FILE=/app/logs/.watchdog_exits

